# Server
PORT=8080
APP_PASSWORD=change-me
READONLY_PASSWORD=change-me
COOKIE_SECRET=replace-with-a-long-random-secret
COOKIE_SECURE=0
CORS_ORIGIN=*

# Finance vault server sync
FINANCE_VAULT_PASSPHRASE=replace-with-a-long-random-passphrase

# Finance exchange read-only sync
# Create read-only / tax API keys. Do not enable trading or withdrawal permissions.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_BASE_URL=https://api.binance.com
BITGET_API_KEY=
BITGET_API_SECRET=
# Optional. Leave empty for Bitget tax API keys that do not issue a passphrase.
BITGET_API_PASSPHRASE=
BITGET_BASE_URL=https://api.bitget.com
# Optional outbound HTTP(S) proxy for exchange API calls.
EXCHANGE_API_PROXY_URL=

# Optional Mihomo local proxy core settings.
MIHOMO_CONTROLLER_SECRET=
MIHOMO_SUBSCRIPTION_URL=
MIHOMO_SELECTED_PROXY=
# "file" means Mihomo should load the locally imported provider file instead of fetching the subscription URL.
MIHOMO_PROVIDER_MODE=

# ClawBot / WeChat rule-only adapter
CLAWBOT_SECRET=replace-with-a-random-shared-secret
CLAWBOT_WEBHOOK_URL=

# Error-theme embedding worker
EMBEDDING_PYTHON=python3
EMBEDDING_CACHE_DIR=./data/embedding-models
EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5
LARGE_EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-large
HF_ENDPOINT=

# Vite development proxy
VITE_API_PROXY_TARGET=http://127.0.0.1:8080

# Operational guardrails
REQUEST_LOG_SLOW_MS=1500
JSON_BODY_MAX_BYTES=10485760
LIBRARY_UPLOAD_MAX_BYTES=367001600
MIN_FREE_DISK_BYTES=536870912
