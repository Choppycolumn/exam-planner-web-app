# Web runtime
PORT=8080
SERVICE_ROLE=all
NODE_ENV=production
APP_PASSWORD=
READONLY_PASSWORD=
COOKIE_SECRET=
SETTINGS_ENCRYPTION_KEY=
COOKIE_SECURE=1
CORS_ORIGIN=
MAX_USERS=10
DATA_DIR=
STATIC_ROOT=
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_DEPLOY=5
BACKUP_KEEP_MANUAL=5
BACKUP_KEEP_MIGRATION=5
BACKUP_KEEP_OTHER=3
STATIC_ASSET_RETENTION_DAYS=14
BACKGROUND_TASK_CONCURRENCY=1
BACKGROUND_MIN_AVAILABLE_MEMORY_BYTES=100663296
BACKGROUND_MAX_LOAD_PER_CPU=1.5
ERROR_THEME_TIME=03:30
MAINTENANCE_TIME=05:20

# Dedicated synchronization credentials
BREAK_GUARD_TOKEN=
BACKUP_SYNC_TOKEN=
DATA_IMPORT_TOKEN=

# Notifications
BARK_DEVICE_KEY=
BARK_SERVER_URL=https://api.day.app
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USER_ID=
TELEGRAM_WEBHOOK_URL=
CLAWBOT_SECRET=
CLAWBOT_WEBHOOK_URL=
WECOM_WEBHOOK_URL=

# Optional proxy integration
PROXY_SETTINGS_ENV_FILE=/etc/exam-planner/proxy.env
MIHOMO_CONTROLLER_SECRET=

# Retired Market Copilot and Library routes are permanently disabled.
# Historical database tables and files remain available to backups only.
