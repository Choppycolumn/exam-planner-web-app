[Unit]
Description=Exam Planner Privileged Helper
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=examplanner
WorkingDirectory=/opt/exam-planner/current
Environment=NODE_ENV=production
Environment=PRIVILEGED_HELPER_SOCKET=/run/exam-planner/privileged.sock
ExecStart=/opt/node-v22.22.3-linux-x64/bin/node /opt/exam-planner/current/server/privileged-helper.mjs
Restart=always
RestartSec=5
MemoryAccounting=true
MemoryHigh=80M
MemoryMax=128M
TasksMax=32
CPUWeight=40
OOMPolicy=stop
RuntimeDirectory=exam-planner
RuntimeDirectoryMode=0750
UMask=0007
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/etc/exam-planner /etc/mihomo /run/exam-planner

[Install]
WantedBy=multi-user.target
