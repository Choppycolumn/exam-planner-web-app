[Unit]
Description=Exam Planner Web
After=network-online.target exam-planner-privileged.service
Wants=network-online.target
Requires=exam-planner-privileged.service

[Service]
Type=simple
User=examplanner
Group=examplanner
SupplementaryGroups=adm systemd-journal
WorkingDirectory=/opt/exam-planner/current
Environment=NODE_ENV=production
Environment=NODE_OPTIONS=--max-old-space-size=160
Environment=DATA_DIR=/opt/exam-planner/data
Environment=STATIC_ROOT=/opt/exam-planner/current/dist
Environment=COOKIE_SECURE=1
Environment=TELEGRAM_ENV_FILE=/opt/exam-planner/data/telegram.env
Environment=HBR_STATUS_FILE=/opt/exam-planner/data/hbr-status.json
Environment=PRIVILEGED_HELPER_SOCKET=/run/exam-planner/privileged.sock
EnvironmentFile=-/etc/exam-planner/runtime.env
EnvironmentFile=-/etc/exam-planner/bark.env
ExecStart=/opt/node-v22.22.3-linux-x64/bin/node /opt/exam-planner/current/server/web.mjs
Restart=always
RestartSec=5
TimeoutStopSec=15
MemoryAccounting=true
MemoryLow=96M
MemoryHigh=192M
MemoryMax=256M
TasksMax=64
CPUWeight=500
IOWeight=500
OOMPolicy=stop
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/opt/exam-planner/data

[Install]
WantedBy=multi-user.target
